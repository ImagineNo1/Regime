# نام کاربری و رمز ورود به سایت
APP_USERNAME=admin
APP_PASSWORD=change-me

# یک رشته تصادفی طولانی (حداقل ۳۲ کاراکتر) برای امضای کوکی ورود
# مثلاً خروجی این دستور:  openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# آدرس دیتابیس MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rezhim
