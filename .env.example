# یک رشته تصادفی طولانی (حداقل ۳۲ کاراکتر) برای امضای کوکی ورود
# مثلاً خروجی این دستور:  openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# آدرس دیتابیس MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rezhim

# ثبت‌نام آزاد است؛ برای بستن ثبت‌نام کاربر جدید:  ALLOW_SIGNUP=false
ALLOW_SIGNUP=true

# (اختیاری) یک حساب که هنگام راه‌اندازی ساخته می‌شود.
# اگر از نسخه تک‌کاربره قبلی ارتقا می‌دهید، همین دو خط را نگه دارید تا همه داده‌های قبلی
# (ثبت‌ها، وزن‌ها، بانک غذا و تنظیمات به‌عنوان «برنامه اول») به این حساب منتقل شود.
APP_USERNAME=admin
APP_PASSWORD=change-me
